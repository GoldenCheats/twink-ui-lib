local function UpdateUIColors()
	for _, v in pairs(UI_Elements.MainFrames) do v.ImageColor3 = CurrentTheme.MainBG end
	for _, v in pairs(UI_Elements.MenuBars) do v.BackgroundColor3 = CurrentTheme.MenuBarBG end
	for _, v in pairs(UI_Elements.Displays) do v.ImageColor3 = CurrentTheme.DisplayBG end
	for _, v in pairs(UI_Elements.TitleBars) do v.ImageColor3 = CurrentTheme.TitleBarBG end
	for _, v in pairs(UI_Elements.Elements) do v.ImageColor3 = CurrentTheme.ElementBG end
	for _, v in pairs(UI_Elements.Texts) do v.TextColor3 = CurrentTheme.TextColor end
    
    for _, v in pairs(UI_Elements.Shadows) do 
        if v:IsA("ImageLabel") then
            v.ImageColor3 = CurrentTheme.GlowColor 
        end
    end
    
	for _, v in pairs(UI_Elements.Tabs) do
		if v:FindFirstChild("IsActiveTab") and v.IsActiveTab.Value == true then
			v.ImageColor3 = CurrentTheme.ActiveTab
		else
			v.ImageColor3 = CurrentTheme.InactiveTab
		end
	end
end

local function GetXY(GuiObject)
	local X, Y = Mouse.X - GuiObject.AbsolutePosition.X, Mouse.Y - GuiObject.AbsolutePosition.Y
	local MaxX, MaxY = GuiObject.AbsoluteSize.X, GuiObject.AbsoluteSize.Y
	X, Y = math.clamp(X, 0, MaxX), math.clamp(Y, 0, MaxY)
	return X, Y, X/MaxX, Y/MaxY
end

