			local HueBar = RoundBox(3)
			HueBar.Size = UDim2.new(1, 0, 0, 15)
			HueBar.ImageColor3 = Color3.new(1,1,1)
			HueBar.Parent = HSVFrame

			local HueGrad = Instance.new("UIGradient")
			HueGrad.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
				ColorSequenceKeypoint.new(0.167, Color3.fromHSV(0.167, 1, 1)),
				ColorSequenceKeypoint.new(0.333, Color3.fromHSV(0.333, 1, 1)),
				ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
				ColorSequenceKeypoint.new(0.667, Color3.fromHSV(0.667, 1, 1)),
				ColorSequenceKeypoint.new(0.833, Color3.fromHSV(0.833, 1, 1)),
				ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1))
			}
			HueGrad.Parent = HueBar

			local HuePointer = Frame()
			HuePointer.Size = UDim2.new(0, 2, 1, 4)
			HuePointer.Position = UDim2.new(H, -1, 0, -2)
			HuePointer.BackgroundColor3 = Color3.new(1,1,1)
			HuePointer.Parent = HueBar

			local SVContainer = RoundBox(3)
			SVContainer.Size = UDim2.new(1, 0, 0, 145)
			SVContainer.Position = UDim2.new(0, 0, 0, 20)
			SVContainer.ImageColor3 = Color3.fromHSV(H, 1, 1)
			SVContainer.Parent = HSVFrame

			local SatFrame = Frame()
			SatFrame.Size = UDim2.new(1,0,1,0)
			SatFrame.Parent = SVContainer
			local SatGrad = Instance.new("UIGradient", SatFrame)
			SatGrad.Color = ColorSequence.new(Color3.new(1,1,1))
			SatGrad.Transparency = NumberSequence.new(0, 1)

			local ValFrame = Frame()
			ValFrame.Size = UDim2.new(1,0,1,0)
			ValFrame.Parent = SVContainer
			local ValGrad = Instance.new("UIGradient", ValFrame)
			ValGrad.Rotation = 90
			ValGrad.Color = ColorSequence.new(Color3.new(0,0,0))
			ValGrad.Transparency = NumberSequence.new(1, 0)

			local Cursor = RoundBox(10)
			Cursor.Size = UDim2.new(0,8,0,8)
			Cursor.AnchorPoint = Vector2.new(0.5, 0.5)
			Cursor.Position = UDim2.new(S, 0, 1-V, 0)
			Cursor.Parent = SVContainer
			Instance.new("UIStroke", Cursor).Thickness = 1.5

			local function UpdateVisuals()
                -- MODIFIED: Applied math.round to ensure no decimals in callback
				local finalColor = Color3.fromHSV(H, S, V)
                local r, g, b = math.round(finalColor.R * 255), math.round(finalColor.G * 255), math.round(finalColor.B * 255)
				PickerRightSide.ImageColor3 = Color3.fromRGB(r, g, b)
				SVContainer.ImageColor3 = Color3.fromHSV(H, 1, 1)
				HuePointer.Position = UDim2.new(H, -1, 0, -2)
				Cursor.Position = UDim2.new(S, 0, 1-V, 0)
			end

			HueBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					local Conn; Conn = RunService.RenderStepped:Connect(function()
						if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then Conn:Disconnect() return end
						local _, _, XScale = GetXY(HueBar)
						H = XScale UpdateVisuals() 
                        local finalColor = Color3.fromHSV(H,S,V)
                        Callback(Color3.fromRGB(math.round(finalColor.R*255), math.round(finalColor.G*255), math.round(finalColor.B*255)))
					end)
				end
			end)

			SVContainer.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					local Conn; Conn = RunService.RenderStepped:Connect(function()
						if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then Conn:Disconnect() return end
						local _, _, XScale, YScale = GetXY(SVContainer)
						S, V = XScale, 1 - YScale UpdateVisuals() 
                        local finalColor = Color3.fromHSV(H,S,V)
                        Callback(Color3.fromRGB(math.round(finalColor.R*255), math.round(finalColor.G*255), math.round(finalColor.B*255)))
					end)
				end
			end)
			
			local PickerToggle = false
			local PickerButton = TextButton("")
			PickerButton.Parent = PickerRightSide
			PickerButton.MouseButton1Down:Connect(function()
				PickerToggle = not PickerToggle
				Tween(PickerContainer, {Size = PickerToggle and UDim2.new(1,0,0,200) or UDim2.new(1,0,0,20)})
			end)

			local PickerHandle = {
				Set = function(color)
					H, S, V = Color3.toHSV(color)
					UpdateVisuals()
				end
			}
			return PickerHandle
		end
		
		function PageLibrary.AddToggle(Text, Default, Callback)
			local ThisToggle = Default or false
			local ToggleContainer = Frame()
			ToggleContainer.Size = UDim2.new(1,0,0,20)
			ToggleContainer.BackgroundTransparency = 1
			ToggleContainer.Parent = DisplayPage
			
			local ToggleLeftSide = RoundBox(5)
			ToggleLeftSide.Size = UDim2.new(1,-22,1,0)
			ToggleLeftSide.ImageColor3 = CurrentTheme.ElementBG
			ToggleLeftSide.Parent = ToggleContainer
			table.insert(UI_Elements.Elements, ToggleLeftSide)
			
			local ToggleRightSide = RoundBox(5)
			ToggleRightSide.Position = UDim2.new(1,-20,0,0)
			ToggleRightSide.Size = UDim2.new(0,20,1,0)
			ToggleRightSide.ImageColor3 = CurrentTheme.ActiveTab
			ToggleRightSide.Parent = ToggleContainer
			
			local EffectFrame = Frame()
			EffectFrame.BackgroundColor3 = ThisToggle and CurrentTheme.ToggleTrue or CurrentTheme.ToggleFalse
			EffectFrame.Position = UDim2.new(1,-22,0.2,0)
			EffectFrame.Size = UDim2.new(0,2,0.6,0)
			EffectFrame.Parent = ToggleContainer
			
			local RightTick = TickIcon()
			RightTick.ImageTransparency = ThisToggle and 0 or 1
			RightTick.Parent = ToggleRightSide
			
			local ToggleButton = TextButton(Text, 12)
			ToggleButton.Parent = ToggleLeftSide
			
			ToggleButton.MouseButton1Down:Connect(function()
				ThisToggle = not ThisToggle
				Tween(EffectFrame, {BackgroundColor3 = ThisToggle and CurrentTheme.ToggleTrue or CurrentTheme.ToggleFalse})
				Tween(RightTick, {ImageTransparency = ThisToggle and 0 or 1})
				Callback(ThisToggle)
			end)	
		end

		function PageLibrary.AddSlider(Text, ConfigurationDictionary, Callback)
			local Min = ConfigurationDictionary.Min or 0
			local Max = ConfigurationDictionary.Max or 100
			local Def = ConfigurationDictionary.Default or Min
			local DefaultScale = (Def - Min) / (Max - Min)
			
			local SliderContainer = Frame()
			SliderContainer.Size = UDim2.new(1,0,0,20)
			SliderContainer.BackgroundTransparency = 1
			SliderContainer.Parent = DisplayPage
			
			local SliderForeground = RoundBox(5)
			SliderForeground.ImageColor3 = CurrentTheme.ElementBG
			SliderForeground.Size = UDim2.new(1,0,1,0)
			SliderForeground.Parent = SliderContainer
			table.insert(UI_Elements.Elements, SliderForeground)
			
			local SliderButton = TextButton(Text..": "..Def)
			SliderButton.ZIndex = 6
			SliderButton.Parent = SliderForeground
			
			local SliderFill = RoundBox(5)
			SliderFill.Size = UDim2.new(DefaultScale,0,1,0)
			SliderFill.ImageColor3 = CurrentTheme.SliderFill
			SliderFill.ZIndex = 5
			SliderFill.ImageTransparency = 0.7
			SliderFill.Parent = SliderButton
			
			SliderButton.MouseButton1Down:Connect(function()
				local SliderMove, SliderKill
				SliderMove = Mouse.Move:Connect(function()
					local _, _, XScale = GetXY(SliderButton)
                    -- MODIFIED: Added math.round for clean slider values
					local Value = math.round(Min + ((Max - Min) * XScale))
					Callback(Value)
					SliderButton.Text = Text..": "..tostring(Value)
					SliderFill.Size = UDim2.new(XScale,0,1,0)
				end)
				SliderKill = UserInputService.InputEnded:Connect(function(UserInput)
					if UserInput.UserInputType == Enum.UserInputType.MouseButton1 then
						SliderMove:Disconnect() SliderKill:Disconnect()
					end
				end)
			end)
		end

		function PageLibrary.AddKeybind(Text, Default, Callback)
			local Key = Default
			local Binding = false
			local Btn = PageLibrary.AddButton(Text..": "..(Key and Key.Name or "None"), function()
				Binding = true
			end)
			
			UserInputService.InputBegan:Connect(function(input, gpe)
				if Binding and not gpe then
					if input.UserInputType == Enum.UserInputType.Keyboard then
						Key = input.KeyCode
						Binding = false
						Btn.Text = Text..": "..Key.Name
						Callback(Key)
					end
				end
			end)
		end

		function PageLibrary.AddDropdown(Text, List, Callback)
			local DropdownContainer = Frame()
			DropdownContainer.ClipsDescendants = true
			DropdownContainer.Size = UDim2.new(1,0,0,20)
			DropdownContainer.BackgroundTransparency = 1
			DropdownContainer.Parent = DisplayPage
			
			local DropdownForeground = RoundBox(5)
			DropdownForeground.ImageColor3 = CurrentTheme.ElementBG
			DropdownForeground.Size = UDim2.new(1,0,0,20)
			DropdownForeground.Parent = DropdownContainer
			table.insert(UI_Elements.Elements, DropdownForeground)
			
			local DropdownLabel = TextLabel(Text, 12)
			DropdownLabel.Size = UDim2.new(1,-20,0,20)
			DropdownLabel.Parent = DropdownForeground
			
			local DropIcon = DropdownIcon()
			DropIcon.Parent = DropdownForeground
			
			local DropButton = TextButton("")
			DropButton.Parent = DropdownForeground
			
			local DropListFrame = Frame()
			DropListFrame.Position = UDim2.new(0,0,0,20)
			DropListFrame.Size = UDim2.new(1,0,0,0)
			DropListFrame.BackgroundTransparency = 1
			DropListFrame.Parent = DropdownContainer
			
			local UIList = Instance.new("UIListLayout", DropListFrame)
			UIList.SortOrder = Enum.SortOrder.LayoutOrder
			
			for i, v in pairs(List) do
				local Item = PageLibrary.AddButton(v, function()
					DropdownLabel.Text = Text..": "..v
					Callback(v)
				end, DropListFrame, false)
				Item.Parent.Size = UDim2.new(1,0,0,20)
			end
			
			local Toggled = false
			DropButton.MouseButton1Down:Connect(function()
				Toggled = not Toggled
				Tween(DropdownContainer, {Size = Toggled and UDim2.new(1,0,0, 20 + (#List * 20)) or UDim2.new(1,0,0,20)})
				Tween(DropIcon, {Rotation = Toggled and 180 or 0})
			end)
		end
		
		return PageLibrary
	end

	function TabLibrary.UpdateTheme(Key, NewColor)
		CurrentTheme[Key] = NewColor
		UpdateUIColors()
	end

	function TabLibrary.SetToggleKey(NewKey)
		ToggleKey = NewKey
	end

	function TabLibrary.GetThemeColor(Key)
		return CurrentTheme[Key]
	end

    function TabLibrary.SetDynamicScaling(state)
		DynamicScaling = state
	end
	
	return TabLibrary
end

return UILibrary
